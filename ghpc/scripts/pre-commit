#!/usr/bin/env bash
# Keeps the standing handoff honest. Install with:
#
#     ln -sf ../../ghpc/scripts/pre-commit .git/hooks/pre-commit
#
# Only deterministic invariants live here. A hook that asks "did you consider
# updating the queue" becomes noise, and noise trains you to bypass it.
set -u
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 0
staged() { git diff --cached --name-only | grep -qx "$1"; }
fail() { echo "pre-commit: $*" >&2; exit 1; }

MARK=ghpc/progress.json
NEXT=ghpc/NEXT.md
QUEUE=ghpc/BACKLOG.md

# 1. The mark and the handoff move together.
if staged "$MARK" && ! staged "$NEXT"; then
  fail "$MARK is staged but $NEXT is not.
  Run: python3 ghpc/scripts/progress.py --render && git add $NEXT"
fi

# 2. The generated block must match the mark. Staleness is computed, not judged.
if staged "$MARK" || staged "$NEXT"; then
  if ! python3 ghpc/scripts/progress.py --check >/dev/null 2>&1; then
    fail "$NEXT's generated block is stale.
  Run: python3 ghpc/scripts/progress.py --render && git add $NEXT"
  fi
fi

# 3. If the rung went up, the queue's Now section is stale by definition.
if staged "$MARK"; then
  old=$(git show HEAD:"$MARK" 2>/dev/null | python3 -c \
    'import json,sys
try: print(json.load(sys.stdin)["rung"])
except Exception: print(0)' 2>/dev/null || echo 0)
  new=$(git show :"$MARK" | python3 -c \
    'import json,sys
try: print(json.load(sys.stdin)["rung"])
except Exception: print(0)' 2>/dev/null || echo 0)
  if [ "${new:-0}" -gt "${old:-0}" ] && ! staged "$QUEUE"; then
    fail "rung went $old -> $new but $QUEUE is not staged.
  Progress means the Now section is out of date. Rewrite it, do not append."
  fi
fi
exit 0
