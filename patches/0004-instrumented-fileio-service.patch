index 0000000..bca8d79
--- /dev/null
+++ b/ps2xIOP/src/modules/fileio.cpp
@@ -0,0 +1,152 @@
+#include "../iop_service.h"
+#include "../module_factories.h"
+
+#include <array>
+#include <cstdint>
+#include <iomanip>
+#include <iostream>
+#include <mutex>
+#include <span>
+#include <sstream>
+#include <unordered_map>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kFileioSid = 0x80000001u;
+        constexpr uint32_t kMaxLogsPerFunction = 6u;
+        constexpr uint32_t kMaxPayloadLogBytes = 64u;
+
+        constexpr uint32_t kSidList[] = {kFileioSid};
+
+        // GH2 links Sony's official SDK, whose fileio function numbering is not
+        // guaranteed to match the ps2sdk reimplementation. Observed so far:
+        // function 0xff with an 8 byte payload and function 0x0c with 39 bytes.
+        // Neither matches the ps2sdk table, so this service logs what the game
+        // actually sends before anything is implemented against a guess.
+        class FileioService final : public IopService
+        {
+        public:
+            explicit FileioService(IopHost &host)
+                : m_host(host)
+            {
+            }
+
+            [[nodiscard]] std::string_view name() const override
+            {
+                return "FILEIO";
+            }
+
+            [[nodiscard]] std::span<const uint32_t> sids() const override
+            {
+                return std::span<const uint32_t>(kSidList);
+            }
+
+            void reset() override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_logCounts.clear();
+                m_callCounts.clear();
+            }
+
+            [[nodiscard]] RpcResult handleRpc(const RpcRequest &request) override
+            {
+                RpcResult result;
+                if (request.sid != kFileioSid)
+                {
+                    return result;
+                }
+
+                result.handled = true;
+                result.resultAddress = request.receive.address;
+
+                logCall(request);
+
+                // Acknowledge and hand back a deterministic buffer. Returning a
+                // success code here would be a guess about a protocol we have not
+                // established, and would hide the next failure the way the sceFs
+                // no-op stubs hid the missing bind.
+                if (request.receive.address != 0u && request.receive.size != 0u)
+                {
+                    (void)m_host.zeroGuest(request.receive.address, request.receive.size);
+                }
+
+                return result;
+            }
+
+        private:
+            void logCall(const RpcRequest &request)
+            {
+                bool shouldLog = false;
+                uint32_t callCount = 0u;
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    callCount = ++m_callCounts[request.function];
+                    uint32_t &logged = m_logCounts[request.function];
+                    if (logged < kMaxLogsPerFunction)
+                    {
+                        ++logged;
+                        shouldLog = true;
+                    }
+                }
+
+                if (!shouldLog)
+                {
+                    return;
+                }
+
+                std::ostringstream message;
+                message << "[FILEIO] fn=0x" << std::hex << request.function
+                        << " call#" << std::dec << callCount
+                        << " send=0x" << std::hex << request.send.address
+                        << "/" << std::dec << request.send.size
+                        << " recv=0x" << std::hex << request.receive.address
+                        << "/" << std::dec << request.receive.size;
+
+                const uint32_t payloadBytes =
+                    request.send.size < kMaxPayloadLogBytes ? request.send.size : kMaxPayloadLogBytes;
+                if (request.send.address != 0u && payloadBytes != 0u)
+                {
+                    std::vector<uint8_t> payload(payloadBytes, 0u);
+                    if (m_host.readGuest(request.send.address, payload.data(), payload.size()))
+                    {
+                        message << " bytes=[";
+                        for (size_t index = 0u; index < payload.size(); ++index)
+                        {
+                            if (index != 0u)
+                            {
+                                message << ' ';
+                            }
+                            message << std::hex << std::setw(2) << std::setfill('0')
+                                    << static_cast<uint32_t>(payload[index]);
+                        }
+                        message << ']';
+
+                        // Most fileio-shaped requests lead with a path or a small
+                        // command word, so surface both readings.
+                        message << " ascii=\"";
+                        for (const uint8_t byte : payload)
+                        {
+                            message << (byte >= 0x20u && byte < 0x7Fu ? static_cast<char>(byte) : '.');
+                        }
+                        message << '"';
+                    }
+                }
+
+                std::cerr << message.str() << std::endl;
+            }
+
+            IopHost &m_host;
+            mutable std::mutex m_mutex;
+            std::unordered_map<uint32_t, uint32_t> m_logCounts;
+            std::unordered_map<uint32_t, uint32_t> m_callCounts;
+        };
+    }
+
+    std::unique_ptr<IopService> createFileioService(IopHost &host)
+    {
+        return std::make_unique<FileioService>(host);
+    }
+}
