-        if (bufSize == 0)
+
+        // ps2ResolveGuestPointer masks out-of-range addresses back into RAM and
+        // always succeeds, so the remaining-space check is what actually bounds us.
+        const uint32_t limit = scratch ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+        if (offset >= limit || (limit - offset) < (kRomNameLen + 1u))
         {
-            setReturnS32(ctx, 0);
+            std::cerr << "GetRomName error: no room at guest address 0x"
